#!/bin/sh
# Block commits that contain secrets. Installed by scripts/install-hooks.sh.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Skipping secret scan." >&2
  exit 0
fi
exec gitleaks git --staged --redact --no-banner --config .gitleaks.toml
